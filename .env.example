# ==============================================================================
# SYNAPSEEVENT ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or secret values to version control.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Vercel Postgres / Neon / Supabase)
# ------------------------------------------------------------------------------
# PostgreSQL connection string with SSL required in production/cloud environments.
# Format: postgres://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgres://postgres:postgres@localhost:5432/synapse_event"

# Optional pooled connection string (for serverless environments like Neon/Vercel)
# DATABASE_URL_UNPOOLED="postgres://..."

# ------------------------------------------------------------------------------
# 2. GUEST WORKSPACE & SESSION SECURITY
# ------------------------------------------------------------------------------
# Secret salt used for server-side token hashing and session signing.
# Generate a strong 32+ character random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET_SALT="replace-with-a-secure-32-char-random-salt-for-workspace-tokens"

# Cookie name for guest workspace access token
WORKSPACE_COOKIE_NAME="synapse_ws_token"

# Cookie name for registered user authentication session
AUTH_COOKIE_NAME="synapse_auth_session"

# Environment indicator (development | test | production)
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 3. AI PROVIDER CONFIGURATION (Server-Side Only - Deferred to Phase 2)
# ------------------------------------------------------------------------------
# Google Gemini API Key (keep server-side; NEVER expose via NEXT_PUBLIC_)
GEMINI_API_KEY="your-gemini-api-key-here"

# Model name to utilize
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH CONFIGURATION (Server-Side Only)
# ------------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
#
# Required Settings in Google Cloud Console:
# 1. Authorized JavaScript Origins:
#    - http://localhost:3000
#    - (Production URL, e.g. https://synapse-event.example.com)
# 2. Authorized Redirect URIs:
#    - http://localhost:3000/api/auth/google/callback
#    - (Production URL, e.g. https://synapse-event.example.com/api/auth/google/callback)
#
# Client ID: Web application client ID (safe to identify app)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Client Secret: Secret key (SERVER-SIDE ONLY; NEVER EXPOSE IN CLIENT BUNDLE)
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional public application URL override for callbacks (useful behind reverse proxies)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

